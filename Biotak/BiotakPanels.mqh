#resource "\\Files\\Icons\\pnl_card8.bmp"
#resource "\\Files\\Icons\\pnl_card9.bmp"
#resource "\\Files\\Icons\\pnl_card10.bmp"
// ICON-DIET 2026-09-27: pnl_card11..16 (+f) are 11.4 MB with NO runtime path.
// PnlIsWide() sends any card over PNL_WIDE_MIN_ROWS 10 to the COMPOSED body
// (pnl_cardWtop/mid/bot/fade), and the baked lookup runs only in the !wide
// branch, so the index it clamps is at most 10. The range stays 1..10.
#resource "\\Files\\Icons\\pnl_knob.bmp"
#resource "\\Files\\Icons\\pnl_cb_on.bmp"
#resource "\\Files\\Icons\\pnl_cb_off.bmp"
