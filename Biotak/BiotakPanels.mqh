#define PNL_STEP_GAP   8
#define PNL_TRACK_X    (PNL_PAD_X + PNL_STEP_W + PNL_STEP_GAP)
#define PNL_TRACK_W    (PNL_WEL - 2*PNL_PAD_X - 2*(PNL_STEP_W + PNL_STEP_GAP))
#define PNL_KNOB_W     18
